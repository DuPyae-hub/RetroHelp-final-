APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hours after clinic approval for the patient to tap “I’m coming”; otherwise the booking auto-cancels.
# BOOKING_RESPOND_AFTER_ACCEPT_HOURS=48

# Same MySQL server you open in phpMyAdmin (import / browse database RETROHELP here).
# Empty password: leave DB_PASSWORD= with nothing after the equals sign.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=RETROHELP
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated Vite dev origins for API CORS (localhost vs 127.0.0.1 differ).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# After saving .env: from backend/ run php artisan migrate. If tables already exist
# from a phpMyAdmin import, migrations skip creating them. See optional_retrohelp_alignments.sql.

# First administrator (optional). After setting, run: php artisan db:seed --class=AdminUserSeeder
# Sign in: Profile → Staff tab → enable "Administrator", use this full name + password (no clinic).
# RETROHELP_ADMIN_FULL_NAME="RetroHelp Admin"
# RETROHELP_ADMIN_PASSWORD=your-secure-password

# Local default: no extra MySQL tables. For SESSION_DRIVER=database, migrate first
# so the `sessions` table exists (see 2026_05_04_000010_create_sessions_table).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq — enables the in-app AI customer support widget (POST /api/support/chat).
# Key: https://console.groq.com/keys (never commit real keys)
GROQ_API_KEY=
# Examples: llama-3.1-8b-instant | llama-3.3-70b-versatile | mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant

# Optional free local fallback (Ollama). If GROQ_API_KEY is empty and OLLAMA_ENABLED=true,
# RetroHelp will use your local Ollama model instead.
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
