# Loaded automatically when you run `npm run dev`.
#
# Prefer calling Laravel from the browser (bypasses the Vite /api proxy and avoids 502
# when Node cannot reach PHP). Use the same host/port as `php artisan serve`.
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# If you remove VITE_API_BASE_URL, requests use /api on the Vite host and this target:
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
#
# Laravel Herd / Valet: e.g. VITE_API_BASE_URL=http://retrohelp.test
# Other port: e.g. VITE_API_BASE_URL=http://127.0.0.1:8020
# Optional artisan port when inferring URL (default 8000):
# VITE_API_PORT=8020
#
# From a phone / another PC: php artisan serve --host=0.0.0.0 --port=8000
# and: npm run dev -- --host
